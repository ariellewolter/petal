{
  "name": "petal-task-tracker",
  "version": "1.0.0",
  "description": "A beautiful task and project tracker with file-based sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "audit": "node scripts/audit.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "keywords": ["task", "tracker", "productivity"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.petal.tasktracker",
    "productName": "Petal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tasklist (1).html",
      "storage.js",
      "manifest.json",
      "icon-192.png",
      "icon-512.png",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon-512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    }
  }
}
