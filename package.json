{
  "name": "petal-task-tracker",
  "version": "1.7.4",
  "description": "A beautiful task and project tracker with file-based sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "audit": "node scripts/audit.js",
    "build": "electron-builder --publish never --config electron-builder.config.cjs",
    "build:mac": "electron-builder --mac --publish never --config electron-builder.config.cjs",
    "build:win": "electron-builder --win --publish never --config electron-builder.config.cjs",
    "build:all": "electron-builder --mac --win --publish never --config electron-builder.config.cjs"
  },
  "keywords": ["task", "tracker", "productivity"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.petal.tasktracker",
    "productName": "Petal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tasklist.html",
      "storage.js",
      "manifest.json",
      "icon-192.png",
      "icon-512.png",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
