node_modules/

# App local state / caches (adjust to your real paths)
storage/
data/
*.sqlite
*.db
# Local vault/state JSON only — do not ignore package.json, manifest.json, etc.
storage/**/*.json
data/**/*.json
**/petal.json
**/.vault_manifest.json

# Electron / build cruft
dist/
out/
release/
build/*
!build/icon.icns
!build/entitlements.mac.plist

# OS/editor
.DS_Store
*.log

# Finder duplicate copies of committed app icons (canonical: icon-192.png, icon-512.png)
icon-*\ *.png
